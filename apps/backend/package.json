{
  "name": "@paranoia/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "start": "node dist/apps/backend/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:preset": "tsx scripts/test-graphics-preset.ts",
    "test:jvm": "tsx scripts/test-jvm-flags.ts",
    "test:sodium": "tsx scripts/test-sodium-preset.ts",
    "test:versions": "tsx scripts/test-minecraft-versions.ts",
    "test:auth": "tsx scripts/test-auth-session.ts",
    "test:restore": "tsx scripts/test-auth-restore.ts",
    "test:java": "tsx scripts/test-java-detect.ts",
    "lint": "echo \"no lint configured\"",
    "format": "echo \"no format configured\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@paranoia/contracts": "workspace:*",
    "@prisma/client": "5.22.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "minecraft-launcher-core": "^3.18.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/cors": "^2.8.19",
    "@types/discord-rpc": "^4.0.11",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
