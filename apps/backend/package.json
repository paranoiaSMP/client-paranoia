{
  "name": "@paranoia/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "start": "node dist/apps/backend/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint configured\"",
    "format": "echo \"no format configured\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@paranoia/contracts": "workspace:*",
    "@prisma/client": "5.22.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "minecraft-launcher-core": "^3.18.2",
    "pino": "^9.3.2",
    "pino-http": "^10.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/cors": "^2.8.17",
    "@types/discord-rpc": "^4.0.11",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.2.0",
    "esbuild": "^0.21.5",
    "prisma": "^5.17.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
