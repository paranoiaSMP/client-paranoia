{
  "$schema": "https://schema.tauri.app/acl/capability/2",
  "identifier": "default",
  "description": "Permissions par défaut de la fenêtre principale",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "dialog:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging"
  ]
}