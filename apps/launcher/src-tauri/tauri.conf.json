{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paranoia Client",
  "version": "0.7.23",
  "identifier": "gg.paranoia.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Paranoia Client",
        "width": 1440,
        "height": 900,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "externalBin": [
      "binaries/paranoia-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/paranoiaSMP/client-paranoia/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMThDRkNFN0U1QzUwQUEKUldTcVVGeCt6czhZNDZ0WHg5Z050aU1vUVZzbllQbEZJZkthRWZpODd3TXJwN2VIL2sxSTdVYTQK"
    }
  }
}
