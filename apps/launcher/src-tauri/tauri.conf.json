{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paranoia Client",
  "version": "0.5.8",
  "identifier": "gg.paranoia.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Paranoia Client",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://minotar.net; font-src 'self' data:; connect-src 'self' http://127.0.0.1:47820 http://localhost:47820; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/paranoia-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/paranoiaSMP/client-paranoia/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMThDRkNFN0U1QzUwQUEKUldTcVVGeCt6czhZNDZ0WHg5Z050aU1vUVZzbllQbEZJZkthRWZpODd3TXJwN2VIL2sxSTdVYTQK"
    }
  }
}
