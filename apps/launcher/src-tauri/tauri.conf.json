{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paranoia Client",
  "version": "0.1.0",
  "identifier": "gg.paranoia.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Paranoia Client",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
