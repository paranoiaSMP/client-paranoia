# Configuration de l'API hebergee (apps/api).
# Copier en .env sur le VPS. Toutes les valeurs ont un defaut raisonnable:
# ce fichier sert surtout a documenter ce qui est reglable.

# Le reverse proxy ecoute sur 443 et transmet ici. Ne pas exposer ce port.
PORT=8080
HOST=127.0.0.1
NODE_ENV=production

# Nombre de proxys de confiance devant le service. 1 avec Caddy ou nginx.
# A 0 derriere un proxy, toutes les requetes comptent sur la meme IP et le
# premier joueur actif epuise la limite de debit pour tout le monde.
TRUST_PROXY=1

# Fichier des cosmetiques, relu a chaud. Voir data/cosmetics.example.json.
COSMETICS_FILE=./data/cosmetics.json

# Dossier des textures servies sur /cosmetics. Y deposer les PNG de capes:
# ils deviennent https://api.paranoiastudio.fr/cosmetics/<nom>.png
COSMETICS_ASSETS_DIR=./data/assets

# Presence: un joueur reste "en ligne" PRESENCE_TTL_SECONDS apres son dernier
# signe de vie. Garder une marge large devant l'intervalle de heartbeat.
PRESENCE_TTL_SECONDS=90
HEARTBEAT_INTERVAL_SECONDS=30

# Duree de vie d'un jeton (12 h). Au-dela, le mod refait le handshake Mojang.
TOKEN_TTL_SECONDS=43200

LOOKUP_MAX_UUIDS=500
RATE_LIMIT_PER_MINUTE=120

# Origines autorisees pour le launcher, separees par des virgules.
# Le mod n'en a pas besoin: seul un navigateur applique CORS.
CORS_ALLOWED_ORIGINS=
