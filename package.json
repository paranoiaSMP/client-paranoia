{
  "name": "paranoia-client",
  "private": true,
  "version": "0.5.3",
  "description": "Launcher for Paranoia SMP",
  "packageManager": "pnpm@9.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format"
  }
}
