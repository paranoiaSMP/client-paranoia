# =============================================================================
# Backend
# =============================================================================
# Toutes les variables ci-dessous sont optionnelles: le backend demarre sans
# fichier .env. Copier ce fichier en .env uniquement pour changer un reglage.

PORT=8080
NODE_ENV=development

# Origines autorisees a appeler l'API, en plus du launcher (localhost:1420 et
# les origines tauri://). Separer par des virgules. A renseigner seulement si
# l'API est appelee depuis une autre origine.
# CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Reserve aux modules pas encore branches (Prisma, sessions JWT, application
# Microsoft). Aucun code ne les lit pour l'instant: les laisser vides.
# La connexion Microsoft utilise l'identifiant public du launcher Minecraft et
# n'a besoin d'aucun secret.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paranoia
# JWT_SECRET=                 # 16 caracteres minimum si renseigne
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=

# =============================================================================
# Launcher (prefixes VITE_ et PARANOIA_ exposes par Vite)
# =============================================================================
# Si cette URL change, penser a l'ajouter au connect-src de la CSP dans
# apps/launcher/src-tauri/tauri.conf.json, sinon le webview bloquera l'appel.
PARANOIA_API_BASE_URL=http://localhost:8080
PARANOIA_CDN_BASE_URL=http://localhost:9000/cdn
PARANOIA_UPDATE_CHANNEL=stable
